<%- include('./dashboardHeader') %>

    <div class="container my-5">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h2>Chefs</h2>

            <a href="/admin/chefs/add" class="btn btn-success">Add Chef</a>

        </div>


        <table class="table table-striped table-hover shadow-sm bg-white rounded">

            <thead class="table-dark">

                <tr>

                    <th>#</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Speciality</th>
                    <th>Experience</th>
                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>

                <% chefs.forEach((chef,i)=>{ %>

                    <tr>

                        <td>
                            <%= i+1 %>
                        </td>

                        <td>

                            <% if(chef.image){ %>

                                <img src="<%= chef.image %>" width="50" height="50" class="rounded">

                                <% } %>

                        </td>

                        <td>
                            <%= chef.name %>
                        </td>

                        <td>
                            <%= chef.speciality %>
                        </td>

                        <td>
                            <%= chef.experience %> Years
                        </td>

                        <td>

                            <a href="/admin/chefs/edit/<%= chef._id %>" class="btn btn-primary btn-sm">
                                Edit
                            </a>

                            <form action="/admin/chefs/delete/<%= chef._id %>" method="POST" class="d-inline">

                                <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>

    <%- include('./dashboardFooter') %>